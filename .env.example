# ---------------------------------------------------------------------------
# MEYRO environment template — copy to `.env` and fill in locally.
# NEVER commit the real `.env`. NEVER place real health data here.
# ---------------------------------------------------------------------------

# --- Runtime ---
MEYRO_ENV=development            # development | staging | production
MEYRO_LOG_LEVEL=INFO
MEYRO_SEED=1337                  # deterministic seed for reproducible runs

# --- Paths (override the defaults in configs/) ---
MEYRO_DATA_DIR=./data
MEYRO_MODELS_DIR=./models
MEYRO_RESULTS_DIR=./results

# --- Database (PostgreSQL, Phase 20) ---
MEYRO_DATABASE_URL=postgresql+psycopg://meyro:meyro@localhost:5432/meyro

# --- API (Phase 19) ---
MEYRO_API_HOST=0.0.0.0
MEYRO_API_PORT=8000
MEYRO_JWT_SECRET=replace-me-with-a-long-random-value
MEYRO_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Experiment tracking (Phase 29) ---
MLFLOW_TRACKING_URI=./mlruns

# --- Optional cache (only if actually needed) ---
# MEYRO_REDIS_URL=redis://localhost:6379/0
